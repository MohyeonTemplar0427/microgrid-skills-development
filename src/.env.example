# Required for all carbon-intensity retrieval.
ELECTRICITY_MAPS_API_KEY=your_api_key_here

# Required for the gridstatus_io market provider
# (region: pjm_western_hub_gridstatus), which reaches PJM and other ISOs
# through the GridStatus.io hosted API. Self-serve signup; the free tier is
# metered at 500,000 rows per month.
# Key from https://www.gridstatus.io/settings/api
GRIDSTATUS_API_KEY=your_gridstatus_api_key_here

# Required only for the pjm provider (region: pjm_western_hub), which calls
# PJM's own Data Miner 2 API. Non-member accounts must first email PJM to
# confirm internal-use-only before a key is issued.
# Register at https://dataminer2.pjm.com/
PJM_API_KEY=your_pjm_api_key_here

# The caiso and ercot providers need no credentials.
